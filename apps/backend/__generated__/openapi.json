{
  "openapi": "3.1.0",
  "info": {
    "title": "Backend",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Return the health status of the application.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Gethealth"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Create User",
        "description": "Create a new user account and start a session.",
        "operationId": "createUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/current": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get Current User",
        "description": "Return the currently authenticated user.",
        "operationId": "getCurrentUser",
        "parameters": [
          {
            "name": "sessionid",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sessionid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/user-sessions": {
      "post": {
        "tags": [
          "user-sessions"
        ],
        "summary": "Create User Session",
        "description": "Authenticate and create a new session.",
        "operationId": "createUserSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/user-sessions/current": {
      "delete": {
        "tags": [
          "user-sessions"
        ],
        "summary": "Delete Current Session",
        "description": "Log out by invalidating the current session.",
        "operationId": "deleteCurrentSession",
        "parameters": [
          {
            "name": "sessionid",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sessionid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads": {
      "post": {
        "tags": [
          "uploads"
        ],
        "summary": "Create Upload",
        "description": "Create a new GPX file upload and return a presigned URL.",
        "operationId": "createUpload",
        "parameters": [
          {
            "name": "sessionid",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sessionid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "uploads"
        ],
        "summary": "List Uploads",
        "description": "List the authenticated user's uploads, filtered by status.",
        "operationId": "listUploads",
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "exclusiveMinimum": 0,
              "default": 20,
              "title": "Page Size"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "statuses",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UploadStatusValue"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Statuses"
            }
          },
          {
            "name": "sessionid",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sessionid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResult_UploadResponse_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUploadRequest": {
        "properties": {
          "original_filename": {
            "type": "string",
            "title": "Original Filename"
          },
          "file_size_bytes": {
            "type": "integer",
            "title": "File Size Bytes"
          }
        },
        "type": "object",
        "required": [
          "original_filename",
          "file_size_bytes"
        ],
        "title": "CreateUploadRequest",
        "description": "Request body for creating a new upload."
      },
      "CreateUserRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "CreateUserRequest",
        "description": "Request body for user registration."
      },
      "CreateUserSessionRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "CreateUserSessionRequest",
        "description": "Request body for login."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PaginatedResult_UploadResponse_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/UploadResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "previous_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Cursor"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "has_previous": {
            "type": "boolean",
            "title": "Has Previous"
          },
          "has_next": {
            "type": "boolean",
            "title": "Has Next"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size",
            "description": "Number of items returned in this page.\n\nReturns:\n    The length of the items list.",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "items",
          "previous_cursor",
          "next_cursor",
          "has_previous",
          "has_next",
          "page_size"
        ],
        "title": "PaginatedResult[UploadResponse]"
      },
      "UploadResponse": {
        "properties": {
          "uid": {
            "type": "string",
            "title": "Uid"
          },
          "original_filename": {
            "type": "string",
            "title": "Original Filename"
          },
          "file_size_bytes": {
            "type": "integer",
            "title": "File Size Bytes"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "current_status": {
            "type": "string",
            "title": "Current Status"
          },
          "presigned_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Presigned Url"
          },
          "required_headers": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Required Headers"
          }
        },
        "type": "object",
        "required": [
          "uid",
          "original_filename",
          "file_size_bytes",
          "created_at",
          "current_status"
        ],
        "title": "UploadResponse",
        "description": "Response body for upload endpoints."
      },
      "UploadStatusValue": {
        "type": "string",
        "enum": [
          "UPLOAD_PENDING",
          "UPLOAD_RECEIVED",
          "UPLOAD_SUCCESS",
          "UPLOAD_INVALID"
        ],
        "title": "UploadStatusValue",
        "description": "Allowed status values for upload processing."
      },
      "UserResponse": {
        "properties": {
          "uid": {
            "type": "string",
            "title": "Uid"
          },
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "uid",
          "email"
        ],
        "title": "UserResponse",
        "description": "Response body for user endpoints."
      },
      "UserSessionResponse": {
        "properties": {
          "uid": {
            "type": "string",
            "title": "Uid"
          },
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "uid",
          "email"
        ],
        "title": "UserSessionResponse",
        "description": "Response body after successful login."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
