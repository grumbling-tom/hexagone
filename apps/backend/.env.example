ENV=DEV

# Must match the SeaweedFS admin identity in docker-compose.yml so presigned
# URLs are signed with a key the local S3 accepts.
AWS_ACCESS_KEY_ID=000000000000
AWS_SECRET_ACCESS_KEY=test
HEXAGONE_S3_ENDPOINT_URL=http://localhost:4566

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@hexagone.app
APP_BASE_URL=http://localhost:3000
