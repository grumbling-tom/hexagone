{
  "name": "@hexagone/web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "lint:css": "stylelint 'src/**/*.css'",
    "test:watch": "vitest",
    "api:gen-spec": "UV_WORKING_DIRECTORY=../backend uv run python src/scripts/generate_openapi.py",
    "api:gen-client": "orval --config ./orval.config.ts",
    "api:gen": "pnpm api:gen-spec && pnpm api:gen-client"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.2.0",
    "@tanstack/react-query": "^5.90.21",
    "astro": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "happy-dom": "^20.7.0",
    "orval": "7.3.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.4.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "stylelint-selector-bem-pattern": "^4.0.1",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
