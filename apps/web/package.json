{
  "name": "@hexagone/web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:imports": "node scripts/check-imports.mjs",
    "lint:app-structure": "node scripts/check-app-structure.mjs",
    "test:watch": "vitest",
    "api:gen-spec": "UV_WORKING_DIRECTORY=../backend uv run python src/scripts/generate_openapi.py",
    "api:gen-client": "orval --config ./orval.config.ts",
    "api:gen": "pnpm api:gen-spec && pnpm api:gen-client"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/geo-layers": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@deck.gl/react": "^9.3.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/otel": "^2.1.3",
    "maplibre-gl": "^5.24.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.1.1",
    "server-only": "^0.0.1",
    "set-cookie-parser": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/set-cookie-parser": "^2.4.10",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "happy-dom": "^20.7.0",
    "orval": "7.3.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.4.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "stylelint-selector-bem-pattern": "^4.0.1",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "sharp"
    ]
  }
}
