PUBLIC_BACKEND_BASE_URL=http://localhost:8000

# MapLibre style URL. OpenFreeMap is a free, no-signup, public CDN serving
# MapLibre-native vector tiles. Swap to a Protomaps API URL or a self-hosted
# PMTiles file later by changing this value — no code change required.
PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
