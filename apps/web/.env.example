# Copy to .env.local for local development. Every var here is declared and
# validated in src/config/env.ts — import `env` from there, never process.env.

# Origin that Next's `/api/:path*` rewrite proxies to. Defaults to the local
# uvicorn server, so this is only needed if your backend runs elsewhere. In
# production it's set on the Deployment to the in-cluster backend Service.
# Consumed at build time, so changing it requires a rebuild.
BACKEND_ORIGIN=http://localhost:8000
